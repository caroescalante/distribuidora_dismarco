generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
   directUrl = env("DIRECT_URL")
}

model caja {
  id                    Int                    @id @default(autoincrement())
  monto_pendiente_pago  Decimal                @default(0.00) @db.Decimal(12, 2)
  monto_total           Decimal                @default(0.00) @db.Decimal(12, 2)
  monto_deuda           Decimal                @default(0.00) @db.Decimal(12, 2)
  monto_destinado_deuda Decimal                @default(0.00) @db.Decimal(12, 2)
  monto_ganancia        Decimal                @default(0.00) @db.Decimal(12, 2)
  monto_perdida         Decimal                @default(0.00) @db.Decimal(12, 2)
  monto_inversion       Decimal                @default(0.00) @db.Decimal(12, 2)
  tipo_impacto          tipo_impacto_caja_enum @default(movimiento_externo)
  referencia_id         Int?
  nota                  String?                @db.VarChar(200)
  dinero_extraido       si_no_enum             @default(si)
  fecha                 DateTime?              @db.Date
  monto_movimiento      Decimal                @default(0.00) @db.Decimal(12, 2)
}

model movimientosexternos {
  id                            Int                             @id @default(autoincrement())
  created                       DateTime?                       @default(now()) @db.Timestamp(6)
  modified                      DateTime?                       @default(now()) @db.Timestamp(6)
  fecha_movimiento              DateTime                        @default(dbgenerated("CURRENT_DATE")) @db.Date
  descripcion                   String                          @db.VarChar(1000)
  tipo_movimiento               tipo_movimiento_enum
  monto_total                   Decimal                         @db.Decimal(12, 2)
  cantidad_total                Int
  pago                          si_no_enum
  medio_de_pago                 medio_pago_enum
  factura                       si_no_enum?                     @default(no)
  nro_comprobante                String?                        @db.VarChar(255)
  nota                          String?                         @db.VarChar(200)
  entregado                     si_no_enum?                     @default(no)
  proveedor                     String?                         @db.VarChar(255)
  estado                        estado_movimiento_enum?
  monto_ganancia_generada       Decimal                         @default(0.00) @db.Decimal(12, 2)
  monto_perdida_generada        Decimal                         @default(0.00) @db.Decimal(12, 2)
  creditosclientes              creditosclientes[]
  movimientosexternosproductos  movimientosexternosproductos[]
}

model movimientosexternosproductos {
  id                    Int                  @id @default(autoincrement())
  movimiento_externo_id Int
  producto_id           Int?
  nombre_producto       String               @db.VarChar(255)
  cantidad              Int
  precio_unitario       Decimal              @db.Decimal(12, 2)
  movimientosexternos   movimientosexternos  @relation(fields: [movimiento_externo_id], references: [id], onDelete: Cascade)
  productos             productos?           @relation(fields: [producto_id], references: [id], onDelete: SetNull)
}

model creditosclientes {
  id                    Int                    @id @default(autoincrement())
  movimiento_externo_id Int?
  descripcion           String                 @db.VarChar(1000)
  monto_pendiente       Decimal                @default(0.00) @db.Decimal(12, 2)
  nombre_cliente        String?                @db.VarChar(255)
  estado                estado_movimiento_enum @default(presupuestado)
  monto_total           Decimal?               @db.Decimal(12, 2)
  monto_pago            Decimal?               @db.Decimal(12, 2)
  medio_de_pago         medio_pago_enum?
  fecha                 DateTime?              @db.Date
  movimientosexternos   movimientosexternos?   @relation(fields: [movimiento_externo_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_movimiento_externo")
}

model productos {
  id                            Int                             @id @default(autoincrement())
  created                       DateTime?                       @default(now()) @db.Timestamp(6)
  modified                      DateTime?                       @default(now()) @db.Timestamp(6)
  descripcion                   String                          @db.VarChar(1000)
  precio                        Decimal                         @db.Decimal(10, 2)
  precio_costo                  Decimal?                        @db.Decimal(10, 2)
  nota                          String?                         @db.VarChar(200)
  stock_disponible              Int?                            @default(0)
  proveedor                     String?                         @db.VarChar(200)
  habilitado                    si_no_enum                      @default(si)
  movimientosexternosproductos  movimientosexternosproductos[]
}

model gastospersonales {
  id          Int      @id @default(autoincrement())
  created     DateTime? @default(now()) @db.Timestamp(6)
  fecha_pago  DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  descripcion String   @db.VarChar(500)
  monto       Decimal  @db.Decimal(12, 2)
}

model usuarios {
  id                Int        @id @default(autoincrement())
  usuario           String     @unique @db.VarChar(100)
  password_hash     String     @db.VarChar(255)
  nombre            String?    @db.VarChar(255)
  activo            si_no_enum @default(si)
  intentos_fallidos Int        @default(0)
  bloqueado_hasta   DateTime?  @db.Timestamp(6)
  created           DateTime?  @default(now()) @db.Timestamp(6)
  ultimo_acceso     DateTime?  @db.Timestamp(6)
}

enum estado_movimiento_enum {
  presupuestado
  armado
  pago
  no_pago
  entregado
  cancelado
  completo
  pedido
  retirado
}

enum medio_pago_enum {
  efectivo
  transferencia
  tarjeta
  varios
}

enum si_no_enum {
  si
  no
}

enum tipo_impacto_caja_enum {
  ganancia
  perdida
  inversion
  deuda
  prestamo
  movimiento_externo
  creditos_clientes
}

enum tipo_movimiento_enum {
  ingreso
  egreso
}
